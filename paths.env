# paths.env - Centralized path definitions for AuthForge (Task 5 / M0, review H2)
#
# Single source of truth for source directories, build output paths, SQL /
# config paths referenced by manage.ps1 / manage.sh, scripts/backend/*, and
# CMake (see cmake/Paths.cmake).
#
# IMPORTANT:
#   - This file only centralizes the CURRENT (pre-refactor) path values.
#     It does not change any actual path yet -- that happens in later
#     milestones (M2a/M3/M8), which only need to edit THIS file plus the
#     handful of "path sync" tasks that reference it.
#   - Format: KEY=VALUE. No spaces around '=', no quotes, no inline
#     comments on value lines. This keeps the file parseable by:
#       * Bash:       `source paths.env` (valid POSIX assignment syntax)
#       * PowerShell: scripts/backend/paths-loader.ps1 (Import-PathsEnv)
#       * Batch:      `for /f "eol=# tokens=1,2 delims==" ...`
#       * CMake:      cmake/Paths.cmake (file(STRINGS ...))
#   - Paths are relative to the repository root unless the key name says
#     otherwise (e.g. *_REL_* keys are relative to another dir below).

# --- Source directories (current, pre-refactor layout) ---
OAUTH2_PLUGIN_DIR=OAuth2Plugin
OAUTH2_SERVER_DIR=OAuth2Server
OAUTH2_ADMIN_DIR=OAuth2Admin
OAUTH2_FRONTEND_DIR=OAuth2Frontend

# --- libs/ (M2a+, additive alongside the pre-refactor layout above) ---
LIBS_COMMON_DIR=libs/common
LIBS_COMMON_TESTING_DIR=libs/common/testing
LIBS_OAUTH2_DIR=libs/oauth2
LIBS_STORAGE_POSTGRES_DIR=libs/storage-postgres
LIBS_IDENTITY_DIR=libs/identity
LIBS_DROGON_DIR=libs/drogon

# --- Build output ---
# BUILD_DIR is relative to the repo root; SERVER_BUILD_SUBDIR is the
# sub-directory of BUILD_DIR that holds the server target's build output
# (single- and multi-config generators both use this as the base).
BUILD_DIR=build
SERVER_BUILD_SUBDIR=OAuth2Server
SERVER_BINARY_NAME=OAuth2Server

# --- SQL / migrations (relative to OAUTH2_SERVER_DIR) ---
SQL_DIR=sql
SQL_MIGRATIONS_REL_DIR=sql/migrations
SQL_SEED_REL_DIR=sql/seed

# --- Config files (relative to OAUTH2_SERVER_DIR) ---
CONFIG_FILE=config.json
CONFIG_DEV_FILE=config.dev.json
CONFIG_CI_FILE=config.ci.json
CONFIG_PROD_FILE=config.prod.json

# --- ORM models (relative to OAUTH2_PLUGIN_DIR) ---
MODELS_SRC_REL_DIR=src/models
MODELS_INC_REL_DIR=include/oauth2/models
MODELS_BACKUP_REL_DIR=models_backup

# --- Docker / deploy (relative to repo root) ---
DEPLOY_DOCKER_DIR=deploy/docker
COMPOSE_FILE_REL=deploy/docker/docker-compose.yml
DOCKERFILE_REL=deploy/docker/Dockerfile
