# OAuth2 Server Environment Variables
# Copy to .env and fill in values. These override config.json settings.
# Priority: .env file > system environment variable > config.json defaults.

# ===== Runtime mode =====
# production enables strict startup validation (HTTPS issuer, non-default
# passwords). When set to production, FULLA_ISSUER MUST be an https:// URL,
# otherwise the server refuses to start.
FULLA_ENV=development
# For production use a real HTTPS URL, e.g.: FULLA_ISSUER=https://auth.example.com
FULLA_ISSUER=http://localhost:5555

# ===== JWT signing key =====
# Generate with: ./scripts/generate-jwt-keys.sh
# Leave empty to use ephemeral key (dev only — tokens invalidated on restart).
# Two mutually-exclusive forms:
#   FULLA_JWT_KEY_PATH — path to an RSA private key file
#   FULLA_SIGNING_KEY  — the PEM key material inline
FULLA_JWT_KEY_PATH=
# FULLA_SIGNING_KEY=

# ===== Database =====
FULLA_DB_HOST=127.0.0.1
FULLA_DB_PORT=5432
FULLA_DB_NAME=fulla_db
FULLA_DB_USER=fulla_user
FULLA_DB_PASSWORD=123456

# ===== Redis =====
FULLA_REDIS_HOST=127.0.0.1
FULLA_REDIS_PORT=6379
FULLA_REDIS_PASSWORD=123456

# ===== Server =====
FULLA_LISTEN_PORT=5555

# ===== Frontend URL (for CORS, redirects) =====
FULLA_FRONTEND_URL=http://localhost:5173

# ===== CORS / OAuth redirect URIs =====
# Comma-separated list of allowed browser origins.
FULLA_CORS_ALLOW_ORIGINS=http://localhost:5173
FULLA_VUE_REDIRECT_URI=http://localhost:5173/callback
FULLA_GOOGLE_REDIRECT_URI=http://localhost:5173/callback

# ===== Migration / error verbosity =====
FULLA_AUTO_MIGRATE=true
# false = generic validation error messages (recommended for prod).
DETAILED_VALIDATION_ERRORS=false

# ===== Vue Client Secret (for CONFIDENTIAL clients) =====
FULLA_VUE_CLIENT_SECRET=123456

# ===== SMTP Email Service (leave empty to use console logging) =====
# For 163 mail: host=smtp.163.com, port=465, user=xxx@163.com, password=授权码
FULLA_SMTP_HOST=
FULLA_SMTP_PORT=465
FULLA_SMTP_USER=
FULLA_SMTP_PASSWORD=
FULLA_SMTP_FROM_NAME=OAuth2 Platform
FULLA_SMTP_SSL=true

# ===== External Auth — GitHub =====
FULLA_GITHUB_CLIENT_ID=
FULLA_GITHUB_CLIENT_SECRET=

# ===== External Auth — Google =====
FULLA_GOOGLE_CLIENT_ID=
FULLA_GOOGLE_CLIENT_SECRET=

# ===== External Auth — WeChat (optional) =====
FULLA_WECHAT_APPID=
FULLA_WECHAT_SECRET=
