@PACKAGE_INIT@

# fulla SDK package config template (fulla-sdk-refactor Task 28a).
# configure_package_config_file() expands this once per package into both an
# install-tree and a build-tree <pkg>Config.cmake. The find_dependency() block
# below is generated from the package's declared transitive closure so an
# external `find_package(<pkg>)` resolves every third-party and sibling
# fulla dependency the exported IMPORTED targets reference.
include(CMakeFindDependencyMacro)

@FULLA_FIND_DEPENDENCY_BLOCK@
include("${CMAKE_CURRENT_LIST_DIR}/@FULLA_PKG_NAME@Targets.cmake")

check_required_components(@FULLA_PKG_NAME@)
