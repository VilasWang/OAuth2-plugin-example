{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres",
        "postgresql://fulla_user:${FULLA_DB_PASSWORD:-123456}@${FULLA_DB_HOST:-127.0.0.1}:${FULLA_DB_PORT:-5432}/fulla_db"
      ]
    },
    "redis": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-redis",
        "redis://:${FULLA_REDIS_PASSWORD:-123456}@${FULLA_REDIS_HOST:-127.0.0.1}:${FULLA_REDIS_PORT:-6379}/0"
      ]
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "disabled": true
    },
    "docker": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-docker"
      ],
      "disabled": true
    }
  }
}
